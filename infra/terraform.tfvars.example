aws_region        = "us-east-1"
name              = "llm-profile"
gpu_instance_type = "g7.8xlarge"
install_dcgm_cli  = false

# Replace with the public egress IP range of your VPN/office. Avoid 0.0.0.0/0.
admin_cidr_blocks = ["203.0.113.10/32"]

# IAM user/role ARN used by Terraform and kubectl; do not use an STS session ARN.
cluster_admin_arn = "arn:aws:iam::123456789012:role/your-terraform-operator"

# Request 0/0 to stop GPU compute when idle; use 1/1/1 to start with one GPU node.
gpu_min_size     = 1
gpu_desired_size = 1
gpu_max_size     = 1
